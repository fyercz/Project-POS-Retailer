# Windows batch files are stored with CRLF as-is (so ZIP downloads from GitHub also work)
*.bat -text
*.cmd -text

# Force Unix shell scripts to use LF
*.sh text eol=lf

# Force standard source files to LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
