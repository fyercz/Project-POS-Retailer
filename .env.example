# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: (opsional) kata sandi untuk fitur administratif (update dari GitHub, seed database,
# pembersihan sistem) bila diakses dari perangkat LAIN. Dari komputer server sendiri tidak perlu.
# Kirim lewat header "X-Admin-Token". Kosongkan = fitur itu hanya bisa dipakai dari komputer server.
ADMIN_TOKEN=

# LAN_KEY: (opsional, DISARANKAN bila Wi-Fi toko juga dipakai pembeli/tamu) kunci untuk
# perangkat lain di jaringan. Bila diisi, HP/kasir lain harus dipasangkan dulu dengan membuka
# link pairing yang tampil di menu Server LAN pada komputer server (http://IP-server:3000/?pair=KUNCI),
# atau mengisi "Kunci LAN" di pengaturan Terminal Klien. Halaman QR rak untuk pembeli tetap terbuka.
LAN_KEY=
